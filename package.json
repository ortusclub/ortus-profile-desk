{
  "name": "profile-desk",
  "productName": "Ortus Profile Desk",
  "version": "0.1.6",
  "private": true,
  "description": "Independent local browser profiles with a GoLogin migration assistant",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build": "electron-builder --mac dir --arm64",
    "build:release": "electron-builder --mac dmg --universal"
  },
  "dependencies": {
    "proxy-chain": "3.0.1",
    "puppeteer-core": "25.11.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "electron": "44.4.2",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.profiledesk.app",
    "productName": "Ortus Profile Desk",
    "files": [
      "src/**/*",
      "ui/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "-",
      "icon": "build/icon.png",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "directories": {
      "output": "dist"
    }
  }
}
